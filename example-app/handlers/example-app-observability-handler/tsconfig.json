{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"preserveSymlinks": true,
		"types": ["@cloudflare/workers-types", "node"],
		"noEmit": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["test"]
}
