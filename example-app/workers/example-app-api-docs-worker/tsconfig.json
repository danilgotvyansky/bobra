{
  "compilerOptions": {
    "target": "ES2025",
    "lib": [
      "ES2025"
    ],
    "jsx": "react-jsx",
    "module": "es2022",
    "moduleResolution": "Bundler",
    "preserveSymlinks": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}