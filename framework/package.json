{
  "name": "@danylohotvianskyi/bobra-framework",
  "version": "0.6.1",
  "description": "Bobra Framework - Generic Cloudflare Workers Framework",
  "author": "Danylo Hotvianskyi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilgotvyansky/bobra.git",
    "directory": "framework"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/migrate": {
      "types": "./dist/db/migrate.d.ts",
      "default": "./dist/db/migrate.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "default": "./dist/network/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    },
    "./batteries/auth": {
      "types": "./dist/batteries/auth/index.d.ts",
      "default": "./dist/batteries/auth/index.js"
    },
    "./batteries/search": {
      "types": "./dist/batteries/search/index.d.ts",
      "default": "./dist/batteries/search/index.js"
    },
    "./batteries/openapi": {
      "types": "./dist/batteries/openapi/index.d.ts",
      "default": "./dist/batteries/openapi/index.js"
    },
    "./batteries/metrics": {
      "types": "./dist/batteries/metrics/index.d.ts",
      "default": "./dist/batteries/metrics/index.js"
    }
  },
  "files": [
    "dist",
    "batteries",
    "core",
    "db",
    "logging",
    "middleware",
    "network",
    "node",
    "scripts",
    "*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cloudflare/workers-types": "4.20260608.1",
    "@hono/standard-validator": "^0.2.0",
    "@hono/valibot-validator": "0.6.1",
    "@types/pg": "^8.11.2",
    "@valibot/to-json-schema": "1.7.1",
    "dotenv": "^16.4.1",
    "drizzle-orm": "0.45.2",
    "drizzle-valibot": "0.4.2",
    "hono": "4.12.24",
    "hono-openapi": "1.3.0",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.16.3",
    "postgres": "^3.2.0",
    "ts-node": "^10.9.2",
    "uuidv7": "^1.2.1",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.0",
      "vite": "8.0.16",
      "vitest": "4.1.8",
      "wrangler": "4.98.0",
      "@cloudflare/vitest-pool-workers": "0.16.13"
    }
  }
}
